#!/usr/bin/env python3
"""F2 control/launcher for the AI Assistant (Hyprland global shortcut).

Usage: assistant-control [toggle|wake|sleep|status|ui-toggle|ui-show|ui-hide|stop|ydotool-status]
  (default: toggle)

If the assistant answers on its control socket, the command is forwarded
to the RUNNING instance (works hidden, unfocused, or while sleeping).
Otherwise exactly one instance is launched (lock-guarded, stale sockets
detected via refused connections - never killall/pkill).

ydotool-status is local-only: it reports the computer-use input backend
health (healthy / missing / stopped / unusable / permission) without
touching the assistant, and never performs input.

Test hooks (env): CAT_TALKER_RUNTIME_DIR overrides the socket/lock dir;
CAT_TALKER_SPAWN_ARGV_JSON overrides the spawned process argv.
"""

import fcntl
import json
import os
import subprocess
import sys
import time

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(ROOT, "src"))

from cat_talker.control import lock_path, send_command, socket_path

SPAWN_WAIT_S = float(os.environ.get("CAT_TALKER_SPAWN_WAIT_S", "15.0"))
LOCK_TIMEOUT_S = float(os.environ.get("CAT_TALKER_LOCK_TIMEOUT_S", "10.0"))

# How much of a dead child's spawn log to report on startup failure.
LOG_TAIL_BYTES = 8192


def _runtime_dir():
    return os.environ.get("CAT_TALKER_RUNTIME_DIR")


def _spawn_argv():
    override = os.environ.get("CAT_TALKER_SPAWN_ARGV_JSON")
    if override:
        return json.loads(override)
    return [
        os.path.join(ROOT, ".venv", "bin", "python"),
        "-m", "cat_talker.main",
    ]


def _try_forward(cmd, path):
    try:
        return send_command(cmd, path=path, timeout=3.0)
    except (OSError, ValueError):
        return None


def _spawn_log_path():
    return os.path.join(
        _runtime_dir()
        or os.environ.get("XDG_RUNTIME_DIR")
        or os.path.join(os.path.expanduser("~"), ".cache", "cat-talker"),
        "assistant-control-spawn.log",
    )


def _spawn_child(path, lock_fd):
    """Spawn one child process. Call with the spawn lock held; the held
    lock file descriptor is inherited by the child (same open file
    description), so the child already owns runtimedir ownership when
    it starts serving - and rival launchers stay blocked on the lock
    until this launcher is done waiting (see _await_child_socket)."""
    argv = _spawn_argv()
    argv = _spawn_argv()
    # Fully absolute child environment: works from any caller CWD
    # (Hyprland has none). Same command as a terminal launch:
    #   cd /home/guru/ai-assistant (ROOT)
    #   PYTHONPATH=<ROOT>/src <ROOT>/.venv/bin/python -m cat_talker.main
    child_env = dict(os.environ)
    child_env["PYTHONPATH"] = os.path.join(ROOT, "src") + (
        os.pathsep + child_env["PYTHONPATH"]
        if child_env.get("PYTHONPATH") else ""
    )
    log = _spawn_log_path()
    try:
        os.makedirs(os.path.dirname(log), exist_ok=True)
    except OSError as e:
        return (None, log, f"cannot create spawn log dir: {e}")
    child_env["CAT_TALKER_LOCK_FD"] = str(lock_fd)
    try:
        with open(log, "ab") as out:
            proc = subprocess.Popen(
                argv,
                cwd=ROOT,
                env=child_env,
                stdin=subprocess.DEVNULL,
                stdout=out,
                stderr=subprocess.STDOUT,
                start_new_session=True,
                pass_fds=(lock_fd,),
            )
    except OSError as e:
        return (None, log,
                f"cannot spawn assistant ({argv[0] if argv else '?'}): {e}")
    except ValueError as e:
        return (None, log, f"cannot spawn assistant: {e}")
    return (proc, log, "")


def _await_child_socket(path, proc, log):
    """Wait for the child's control socket; report real failures.

    Returns (True, "") on readiness, else (False, reason). A child that
    exits before serving is reported with its exit code and the tail of
    its captured log - never a bare "did not come up".
    """
    deadline = time.monotonic() + SPAWN_WAIT_S
    while time.monotonic() < deadline:
        if proc.poll() is not None:
            return (False,
                    f"assistant exited (code {proc.returncode}) before "
                    f"the control socket answered. Log tail ({log}):\n"
                    f"{_log_tail(log)}")
        reply = _try_forward("status", path)
        if reply is not None and reply.get("ok"):
            return (True, "")
        time.sleep(0.2)
    if proc.poll() is not None:
        return (False,
                f"assistant exited (code {proc.returncode}) while waiting "
                f"for the control socket. Log tail ({log}):\n{_log_tail(log)}")
    return (False,
            f"assistant did not answer within {SPAWN_WAIT_S:.0f}s "
            f"(still running, pid {proc.pid}). Log: {log}\n{_log_tail(log)}")


def _log_tail(log):
    try:
        with open(log, "rb") as f:
            try:
                f.seek(-LOG_TAIL_BYTES, os.SEEK_END)
            except OSError:
                pass
            return f.read().decode("utf-8", errors="replace")
    except OSError as e:
        return f"<unreadable spawn log: {e}>"


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "toggle"
    if cmd == "ydotool-status":
        # Local-only operator command: never touches the control socket,
        # never launches the assistant, never performs input.
        from cat_talker.ydotool_health import format_ydotool_status
        text, code = format_ydotool_status()
        print(text)
        return code
    if cmd not in ("toggle", "wake", "sleep", "status",
                   "ui-toggle", "ui-show", "ui-hide", "stop"):
        print("usage: assistant-control "
              "[toggle|wake|sleep|status|ui-toggle|ui-show|ui-hide|stop|ydotool-status]",
              file=sys.stderr)
        return 2
    runtime = _runtime_dir()
    path = socket_path(runtime)
    reply = _try_forward(cmd, path)
    if reply is not None and reply.get("ok"):
        print(reply.get("state", "ok"))
        return 0
    if cmd == "stop":
        # Nothing to stop: never launch a process just to quit it.
        print("not running")
        return 0

    # Not answering: take the spawn lock, recheck (another launcher may
    # have won), drop a stale socket, spawn exactly one instance, and
    # wait for readiness while STILL holding the lock. This is safe
    # because the lock fd is inherited by the child, which adopts it as
    # its runtime ownership: rival launchers block (attaching via the
    # recheck below once the socket answers) instead of spawning
    # duplicates, and the child never deadlocks on startup.
    lockf = lock_path(runtime)
    with open(lockf, "a+b") as lock:
        deadline = time.monotonic() + LOCK_TIMEOUT_S
        while True:
            try:
                fcntl.flock(lock.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() > deadline:
                    print("assistant-control: spawn lock busy",
                          file=sys.stderr)
                    return 1
                # A live child may be starting right now: if its socket
                # answers, attach to it instead of waiting on the lock.
                reply = _try_forward(cmd, path)
                if reply is not None and reply.get("ok"):
                    print(reply.get("state", "ok"))
                    return 0
                time.sleep(0.1)
        try:
            reply = _try_forward(cmd, path)
            if reply is not None and reply.get("ok"):
                print(reply.get("state", "ok"))
                return 0
            # Refused/missing: stale file from a dead instance?
            try:
                os.unlink(path)
            except OSError:
                pass
            proc, log, error = _spawn_child(path, lock.fileno())
            if proc is None:
                print(f"assistant-control: {error}", file=sys.stderr)
                return 1
            ok, reason = _await_child_socket(path, proc, log)
            if not ok:
                print(f"assistant-control: {reason}", file=sys.stderr)
                return 1
            reply = _try_forward(cmd, path)
            if reply is not None and reply.get("ok"):
                print(reply.get("state", "ok"))
                return 0
            print("assistant-control: command not acknowledged",
                  file=sys.stderr)
            return 1
        finally:
            try:
                fcntl.flock(lock.fileno(), fcntl.LOCK_UN)
            except OSError:
                pass


if __name__ == "__main__":
    sys.exit(main(sys.argv))
